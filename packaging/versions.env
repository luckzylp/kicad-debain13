# Single source of truth for the downstream build.
#
# This file is sourced by scripts/lib.sh. Keep values shell-safe (no spaces).
# When updating KiCad, update every value and regenerate packaging/sources.sha256.
# See docs/RELEASE.md for the release checklist.

# Upstream KiCad stable release.
UPSTREAM_VERSION="10.0.7"

# Debian source package this downstream build is based on.  The "+dfsg"
# suffix is part of the upstream version, not the Debian revision.
DEBIAN_BASE_VERSION="10.0.7+dfsg-1"
DFSG_UPSTREAM_VERSION="10.0.7+dfsg"
DEBIAN_BASE_REVISION="1"

# Downstream Debian revision: <official revision>+trixie<counter>.
# 10.0.7+dfsg-1+trixie1 sorts above 10.0.7+dfsg-1 and below a future
# 10.0.7+dfsg-2.  Bump the trixie counter for a packaging-only rebuild.
DOWNSTREAM_REVISION="1+trixie1"
DEB_VERSION="${DFSG_UPSTREAM_VERSION}-${DOWNSTREAM_REVISION}"

# Debian source and binary package identity.
SOURCE_NAME="kicad"
BINARY_PACKAGE="kicad"
DEBIAN_SUITE="trixie"
ARCHITECTURE="amd64"

# Git tag that is allowed to publish this exact version.  A tag push is not
# enough: scripts/validate-release-tag.sh requires an exact match.
RELEASE_TAG="v10.0.7"

# Official Debian source artifacts.  They are downloaded directly from the
# Debian archive; no sid apt binary or source index is added to the build
# environment.  Digests live in packaging/sources.sha256.
DEBIAN_MIRROR="https://deb.debian.org/debian"
DEBIAN_POOL_PATH="pool/main/k/kicad"
SOURCE_DSC="kicad_10.0.7+dfsg-1.dsc"
SOURCE_ORIG="kicad_10.0.7+dfsg.orig.tar.xz"
SOURCE_ORIG_DOC="kicad_10.0.7+dfsg.orig-doc.tar.xz"
SOURCE_DEBIAN_TAR="kicad_10.0.7+dfsg-1.debian.tar.xz"

# Default build scope.  "arch" runs dpkg-buildpackage -B and produces only
# the amd64 kicad package.  "full" runs -b and also builds demos and the
# translated documentation (much slower and much larger).
BUILD_SCOPE="arch"
